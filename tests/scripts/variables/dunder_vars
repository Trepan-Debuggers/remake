$description = "Test __FILE__, __LINE__, and __COUNTER__ variables.";

$details = "Tests $(__FILE__), $(__LINE__), and $(__COUNTER__) magic variables";


open(MAKEFILE,"> $makefile");

# The Contents of the MAKEFILE ...

print MAKEFILE <<EOMAKE;
string := \$(__LINE__) \$(__FILE__) \$(__COUNTER__)
one: ; \@echo \$(string)
EOMAKE

# END of Contents of MAKEFILE

close(MAKEFILE);


&run_make_with_options($makefile, "", &get_logfile, 0);

# Create the answer to what should be produced by this Makefile
$answer = "1 work/variables/dunder_vars.mk 1\n";

# COMPARE RESULTS

# In this call to compare output. call &get_logfile(1) is used
# to send the name of the last logfile created.

&compare_output($answer,&get_logfile(1));

# This tells the test driver that the perl test script executed properly.
1;
